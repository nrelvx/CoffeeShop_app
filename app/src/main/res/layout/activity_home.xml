<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_recipes">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".HomeActivity">


        <androidx.cardview.widget.CardView
        android:id="@+id/cardView_latte"
        android:layout_width="350dp"
        android:layout_height="170dp"
        android:layout_marginTop="64dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_home">

        <ImageView
            android:id="@+id/image_latte"
            android:layout_width="109dp"
            android:layout_height="117dp"
            android:layout_marginTop="25dp"
            app:srcCompat="@drawable/latte"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/text_latte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="110dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/baloo"
            android:text="Latte"
            android:textColor="@color/text_recipes"
            android:textSize="20sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/latte_dsc"
            android:layout_width="226dp"
            android:layout_height="108dp"
            android:layout_marginStart="110dp"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/alata"
            android:text="@string/latte"
            android:textSize="14sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="300dp"
            android:clickable="true"
            android:contentDescription="Add to favorites"
            app:backgroundTint="@color/bg_recipes"
            app:fabCustomSize="40dp"
            app:srcCompat="@drawable/favorite"
            tools:ignore="HardcodedText,KeyboardInaccessibleWidget" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_americano"
        android:layout_width="350dp"
        android:layout_height="170dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView_latte">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="300dp"
            android:clickable="true"
            android:contentDescription="Add to favorites"
            app:backgroundTint="@color/bg_recipes"
            app:fabCustomSize="40dp"
            app:srcCompat="@drawable/favorite"
            tools:ignore="HardcodedText,KeyboardInaccessibleWidget" />

        <ImageView
            android:id="@+id/image_americano"
            android:layout_width="85dp"
            android:layout_height="101dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="25dp"
            app:srcCompat="@drawable/americano"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/text_americano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="110dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/baloo"
            android:text="Americano"
            android:textColor="@color/text_recipes"
            android:textSize="20sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/americano_desc"
            android:layout_width="226dp"
            android:layout_height="82dp"
            android:layout_marginStart="110dp"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/alata"
            android:text="@string/americano"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_frappe"
            android:layout_width="350dp"
            android:layout_height="170dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView_americano">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionButton_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="300dp"
                android:clickable="true"
                android:contentDescription="Add to favorites"
                app:backgroundTint="@color/bg_recipes"
                app:fabCustomSize="40dp"
                app:srcCompat="@drawable/favorite"
                tools:ignore="HardcodedText,KeyboardInaccessibleWidget" />

            <TextView
                android:id="@+id/text_frappe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/baloo"
                android:text="Frappe"
                android:textColor="@color/text_recipes"
                android:textSize="20sp"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/image_frappe"
                android:layout_width="97dp"
                android:layout_height="92dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="35dp"
                app:srcCompat="@drawable/frappe"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/frappe_dsc"
                android:layout_width="226dp"
                android:layout_height="110dp"
                android:layout_marginStart="110dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/alata"
                android:text="@string/frappe"
                android:textSize="14sp" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_flat_white"
            android:layout_width="350dp"
            android:layout_height="170dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.491"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView_frappe">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionButton_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="300dp"
                android:clickable="true"
                android:contentDescription="Add to favorites"
                app:backgroundTint="@color/bg_recipes"
                app:fabCustomSize="40dp"
                app:srcCompat="@drawable/favorite"
                tools:ignore="HardcodedText,KeyboardInaccessibleWidget" />

            <TextView
                android:id="@+id/flat_white_dsc"
                android:layout_width="226dp"
                android:layout_height="119dp"
                android:layout_marginStart="110dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/alata"
                android:text="@string/flat_white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_flat_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/baloo"
                android:text="Flat White"
                android:textColor="@color/text_recipes"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/image_flat_white"
                android:layout_width="104dp"
                android:layout_height="96dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="35dp"
                app:srcCompat="@drawable/flat_white" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_espresso"
            android:layout_width="350dp"
            android:layout_height="170dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="90dp"
            app:cardCornerRadius="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardView_flat_white">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/floatingActionButton_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="300dp"
                android:clickable="true"
                android:contentDescription="Add to favorites"
                app:backgroundTint="@color/bg_recipes"
                app:fabCustomSize="40dp"
                app:srcCompat="@drawable/favorite"
                tools:ignore="HardcodedText,KeyboardInaccessibleWidget" />

            <TextView
                android:id="@+id/espresso_dsc"
                android:layout_width="227dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="110dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/alata"
                android:text="@string/espresso"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_espresso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/baloo"
                android:text="Espresso"
                android:textColor="@color/text_recipes"
                android:textSize="20sp"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/image_espresso"
                android:layout_width="77dp"
                android:layout_height="94dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="35dp"
                app:srcCompat="@drawable/espresso"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <TextView
        android:id="@+id/logo_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:fontFamily="@font/baloo"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/recipes"
        android:textColor="@color/text_recipes"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/decor"
            android:layout_width="170dp"
            android:layout_height="5dp"
            android:background="@color/text_recipes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.113" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>