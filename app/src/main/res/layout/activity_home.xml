<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_recipes"
    tools:context=".HomeActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_latte"
        android:layout_width="350dp"
        android:layout_height="170dp"
        android:layout_marginTop="64dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_home">

        <ImageView
            android:id="@+id/image_latte"
            android:layout_width="109dp"
            android:layout_height="117dp"
            android:layout_marginTop="25dp"
            app:srcCompat="@drawable/latte" />

        <TextView
            android:id="@+id/text_latte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="110dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/baloo"
            android:text="Latte"
            android:textColor="@color/text_recipes"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/latte_dsc"
            android:layout_width="226dp"
            android:layout_height="108dp"
            android:layout_marginStart="110dp"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/alata"
            android:text="@string/latte"
            android:textSize="14sp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="300dp"
            android:clickable="true"
            android:contentDescription="Add to favorites"
            app:backgroundTint="@color/bg_recipes"
            app:fabCustomSize="40dp"
            app:srcCompat="@drawable/favorite" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_americano"
        android:layout_width="350dp"
        android:layout_height="170dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView_latte">

        <ImageView
            android:id="@+id/image_americano"
            android:layout_width="85dp"
            android:layout_height="101dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="25dp"
            app:srcCompat="@drawable/americano" />

        <TextView
            android:id="@+id/text_americano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="110dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/baloo"
            android:text="Americano"
            android:textColor="@color/text_recipes"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/americano_desc"
            android:layout_width="226dp"
            android:layout_height="82dp"
            android:layout_marginStart="110dp"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/alata"
            android:text="@string/americano"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/logo_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:fontFamily="@font/baloo"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/recipes"
        android:textColor="@color/text_recipes"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view"
        android:layout_width="170dp"
        android:layout_height="5dp"
        android:background="@color/text_recipes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.142" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_frappe"
        android:layout_width="350dp"
        android:layout_height="170dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView_americano" />

</androidx.constraintlayout.widget.ConstraintLayout>